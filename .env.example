# Copia este archivo a `.env` (raíz del repo) y ajusta para producción.
# Compose lo lee automáticamente para interpolar las variables de los servicios.
# Los secretos del backend (JWT_SECRET, OPENWEATHER_API_KEY) se siguen leyendo de backend/.env.

# Puertos publicados
API_PORT=4000
WEB_PORT=8080

# URL pública de la API tal como la ve el navegador (se incrusta en el bundle del frontend).
# En producción usa tu dominio: https://api.tudominio.mx/api/v1
VITE_API_URL=http://localhost:4000/api/v1

# Origen permitido por CORS (el puerto del frontend web).
CORS_ORIGIN=http://localhost:8080

# Base de las URLs de imágenes subidas (/uploads). En producción: https://api.tudominio.mx
PUBLIC_BASE_URL=http://localhost:4000