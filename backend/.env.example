# Copia este archivo a `.env` y ajusta los valores.

DATABASE_URL="postgresql://lafrontera:lafrontera@localhost:5433/lafrontera?schema=public"

# Genera uno propio, por ejemplo: `openssl rand -hex 32`
JWT_SECRET="cambia-este-secreto-por-uno-aleatorio"

JWT_EXPIRES_IN="7d"
PORT=4000
CORS_ORIGIN="http://localhost:5173"

OPENWEATHER_API_KEY="cambia-esta-api-key-por-la-tuya"
# obtén la tuya gratis en openweathermap.org

# URL pública base para construir las URLs de imágenes subidas en /uploads.
# Si no se define, se usa http://localhost:${PORT}.
PUBLIC_BASE_URL="http://localhost:4000"
